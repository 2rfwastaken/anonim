{
  "name": "early-host",
  "version": "1.0.0",
  "description": "Early.Host — Discord Kullanıcı Adı ve Rozet Tarayıcı (Türkçe)",
  "main": "server.js",
  "scripts": {
    "web": "node server.js",
    "start": "node server.js",
    "scrapper": "node scrapper.js",
    "bot": "node bot.js",
    "test": "node test_system.js",
    "bundle": "esbuild scrapper.js --bundle --platform=node --target=node24 --external:ffmpeg-static --outfile=bundle.js",
    "build:exe": "npm run bundle && npx @yao-pkg/pkg --sea bundle.js -o EarlyHost.exe"
  },
  "keywords": [
    "discord",
    "scraper",
    "selfbot",
    "badge",
    "username"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "discord.js": "^14.27.0",
    "discord.js-selfbot-v13": "^3.4.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.2.1",
    "esbuild": "^0.28.2"
  }
}
